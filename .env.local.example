NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Calendar API (for future integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Instagram stats for Live Media Plans (all server only)
# Service key: reads and writes the stats tables, which browsers can't reach
SUPABASE_SERVICE_ROLE_KEY=
# Scraper key. Without it nothing can be fetched, and saved numbers still show
APIFY_TOKEN=
# Sent by the scheduled job. Without it the schedule route refuses every call
CRON_SECRET=
# Who hears about outages. Without it there are no emails, only the page warning
STATS_ALERT_EMAIL=
# Optional. Estimated scraper spend in USD per day before all fetching stops for that day. Empty means 1
DAILY_LIMIT_USD=
